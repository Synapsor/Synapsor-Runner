            "operator_history_digest": "sha256:e07d7b9b18e40cc36bfe73f9b25483e9bfa9ce4e580d11b8c6ad0bf7ec1bd1fc",
            "reviewed_at": "2026-09-15T19:03:49.246Z"
          }
        }
      ]
    },
