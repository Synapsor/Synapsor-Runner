// Read-only oracle over independently captured source rows and durable ledger bytes.
import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
import {executionReceiptV5Schema} from '@synapsor-runner/protocol';
const E=path.dirname(new URL(import.meta.url).pathname),plan=JSON.parse(fs.readFileSync(path.join(E,'assignment-plan.json'),'utf8')),R=path.join(plan.owned_root,'runs/recovery-tournament-assisted'),D=path.join(R,'deterministic');
const read=(n:string)=>JSON.parse(fs.readFileSync(path.join(D,n+'.json'),'utf8')),sha=(s:string)=>createHash('sha256').update(s).digest('hex');
const before=read('pre-publication-resume-ledger'),added=read('addition-published-ledger'),pre=read('withdrawal-before-approval-ledger'),after=read('final-after-runtime-restart-ledger'),removed=read('removed-work-checked-ledger');
const sourceBefore=read('pre-publication-resume-source'),sourceAfter=read('final-after-runtime-restart-source');
for(const phase of ['addition-published','withdrawal-before-approval','withdrawal-approved-unstarted'])assert.deepEqual(read(phase+'-source'),sourceBefore);
const changes=[];for(const table of Object.keys(sourceBefore)){assert.equal(sourceBefore[table].length,sourceAfter[table].length);for(let i=0;i<sourceBefore[table].length;i++){const a=sourceBefore[table][i],b=sourceAfter[table][i];if(JSON.stringify(a)===JSON.stringify(b))continue;const fields=Object.keys(a).filter(k=>JSON.stringify(a[k])!==JSON.stringify(b[k]));assert.equal(a.result_ref,'primary-R24');assert.deepEqual(fields.sort(),['result_state','version','withdrawal_reason']);assert.equal(b.result_state,'withdrawn');assert.equal(b.version,a.version+1);changes.push({table,subject:a.result_ref,fields});}}
assert.equal(changes.length,1);for(const old of before.approvals)assert(after.approvals.some((r:any)=>JSON.stringify(r)===JSON.stringify(old)));for(const old of before.writeback_receipts)assert(after.writeback_receipts.some((r:any)=>JSON.stringify(r)===JSON.stringify(old)));
const receipts=after.writeback_receipts.map((r:any)=>{const receipt=executionReceiptV5Schema.parse(JSON.parse(r.receipt_json));return{proposal_id:r.proposal_id,authority:receipt.receipt_authority,status:receipt.status,canonical_core_hash:receipt.receipt_hash,stored_bytes_sha256:sha(r.receipt_json),source_mutated:receipt.source_database_mutated,rows_affected:receipt.rows_affected};});assert.equal(receipts.length,2);
const unstarted=after.worker_queue.find((r:any)=>r.proposal_id==='wrp_rule_af24597a6a5232f0ef52d69fd3a174a5');assert.equal(unstarted.status,'queued');assert.equal(unstarted.attempts,0);assert.equal(unstarted.lease_id,null);assert.deepEqual(unstarted,removed.worker_queue.find((r:any)=>r.proposal_id===unstarted.proposal_id));assert.equal(read('removed-unstarted-worker-result').code,0);assert.deepEqual(read('removed-work-checked-source'),read('withdrawal-completed-source'));
const outcomes=(n:string)=>read(n+'-result').result.actions.map((a:any)=>a.outcome);assert.deepEqual(outcomes('after-add-actions'),['league.result_ratification','league.result_withdrawal']);assert.deepEqual(outcomes('after-remove-actions'),['league.result_ratification']);assert.deepEqual(outcomes('runtime-restart-actions'),['league.result_ratification']);assert.equal(read('runtime-restart-own-rows-result').result.data.length,24);assert.equal(read('removed-outcome-refusal-result').result.error_code,'SEMANTIC_ACTION_UNAVAILABLE');assert.equal(read('withdrawal-receipt-replay-result').result.status,'completed');assert.equal(read('ratification-after-removal-result').result.status,'approved_pending_execution');assert.equal(read('retained-history-cap-control-result').result.status,'pending_human_review');
function history(l:any){return l.approvals.filter((a:any)=>a.action_boundary_name!==null&&a.status==='approved').map((a:any)=>{const p=l.proposals.find((p:any)=>p.proposal_id===a.proposal_id);return{proposal_id:a.proposal_id,created_at:a.created_at,boundary:a.action_boundary_name,outcome:p.capability??p.action};});}
const oldAutomatic=history(before),newAutomatic=history(after);assert.equal(oldAutomatic.length,1);assert.equal(newAutomatic.length,2);assert(newAutomatic.every((r:any)=>r.outcome==='league.result_ratification'));assert(oldAutomatic.every((r:any)=>newAutomatic.some((n:any)=>JSON.stringify(n)===JSON.stringify(r))));assert.equal(history(added).length,1);assert.equal(history(pre).length,1);
function authority(l:any){const a=l.control_policy_active.find((r:any)=>r.kind==='action');const rev=l.control_policy_revisions.find((r:any)=>['deployment_id','scope_key','kind','name','revision_id'].every(k=>a[k]===r[k]));return{revision:a.revision_id,authority:JSON.parse(rev.content_json).authority};}
const orig=authority(before),add=authority(added),final=authority(after);assert.deepEqual(final,authority(read('removal-published-ledger')));assert.equal(final.authority.digest,'sha256:3431e33b5c7ef594c67b545c33ae8285cbd919ff01c91bf35f5d72581ad2ea3e');const limits=final.authority.authority.approval_classes[0].shared_limits;assert(limits.every((l:any)=>l.capability==='league.result_ratification'&&l.window_seconds===86400));assert.deepEqual(limits.map((l:any)=>l.maximum).sort((a:number,b:number)=>a-b),[2,6]);
const result={artifact_tree:plan.artifact_tree,source_changes:changes,source_unchanged_before_human_approval_and_worker:true,receipt_records:receipts,worker_diagnostic_hash:'sha256:407362a2191debdcc8504e3552c061f4c3eba60cba41801dcdfe0381e1be3f7e',old_receipt_bytes_and_approvals_retained:true,old_automatic:oldAutomatic,final_automatic:newAutomatic,canonical_filter:'league.result_ratification',limits,history_control:'One old automatic plus one fresh automatic reaches tenant maximum2; distinct eligible R16 persists human review; human withdrawals do not consume this count',active_revisions:{before:orig.revision,addition:add.revision,removal:final.revision},unstarted_removed_work:{proposal_id:unstarted.proposal_id,status:unstarted.status,attempts:unstarted.attempts,lease_id:unstarted.lease_id,worker_exit:0,source_changed:false},continuous_client_pid:2531497,restarted_client_pid:2574854,read_rows_after_restart:24,original_source_receipt_engine_claim:'none; tournament uses Runner ledger, not atomic source receipt',topology:'single-host PostgreSQL source / SQLite control store; one continuing MCP process then explicit restart; two finite worker invocations'};
fs.writeFileSync(path.join(E,'final-runtime-oracle.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(result,null,2));
