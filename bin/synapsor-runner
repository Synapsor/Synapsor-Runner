#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export NODE_NO_WARNINGS="${NODE_NO_WARNINGS:-1}"

if ! command -v node >/dev/null 2>&1; then
  echo "Synapsor Runner requires Node >= 22.13.0. Install Node or use the Docker demo from a source checkout." >&2
  exit 1
fi

if ! node -e "const [major, minor] = process.versions.node.split('.').map(Number); process.exit(major > 22 || (major === 22 && minor >= 13) ? 0 : 1);" >/dev/null 2>&1; then
  echo "Synapsor Runner requires Node >= 22.13.0 because the local ledger uses Node's unflagged node:sqlite runtime." >&2
  echo "Current Node: $(node -p 'process.versions.node' 2>/dev/null || echo unknown). Upgrade Node or use the Docker demo from a source checkout." >&2
  exit 1
fi

if [[ -f "$ROOT/apps/runner/src/cli.ts" && -f "$ROOT/node_modules/tsx/dist/loader.mjs" ]]; then
  # The tsx CLI creates an IPC socket under TMPDIR even without watch mode.
  # Its optional transform cache also creates/cleans a shared temp directory.
  # Source runs use the exported loader with an in-memory cache, avoiding both
  # transient paths while retaining cwd, temporary root, arguments and signals.
  export TSX_DISABLE_CACHE=1
  exec node --import "$ROOT/node_modules/tsx/dist/loader.mjs" "$ROOT/apps/runner/src/cli.ts" "$@"
fi

exec node "$ROOT/apps/runner/dist/cli.js" "$@"
